.tab-bar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 100;
	display: flex;
	background: rgba(11, 11, 12, 0.96);
	border-top: 1rpx solid #2A2A2E;
	padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-item {
	flex: 1;
	height: 96rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4rpx;
	color: #6E6E74;
	font-size: 22rpx;
}

.tab-bar-item.is-active {
	color: #F2F2F4;
}

.tab-icon {
	display: block;
	width: 44rpx;
	height: 44rpx;
	background-repeat: no-repeat;
	background-position: center;
	background-size: contain;
}

.tab-label {
	font-size: 22rpx;
	line-height: 1.2;
}
