<view wx:if="{{!hidden}}" class="tab-bar">
	<view class="tab-bar-item {{selected === index ? 'is-active' : ''}}" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" bindtap="onSwitch">
		<view class="tab-icon tab-icon-{{item.icon}}"></view>
		<text class="tab-label">{{item.text}}</text>
	</view>
</view>
