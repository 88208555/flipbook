.fb-commerce-page{min-height:100vh;box-sizing:border-box;padding:0 32rpx 64rpx;background:#0b0b0c;color:#dadadd;font-size:28rpx;line-height:1.7}
.fb-commerce-nav{display:flex;align-items:center;gap:24rpx;min-height:88rpx;margin-bottom:24rpx;font-size:32rpx;color:#f2f2f4}
.fb-commerce-nav button{margin:0;width:auto;padding:8rpx 20rpx;line-height:1.5;font-size:28rpx}
.fb-commerce-product image,.fb-commerce-detail-image{display:block;width:100%;height:320rpx;margin:16rpx auto;border-radius:20rpx}
.fb-commerce-title{display:block;width:100%;text-align:center;font-size:44rpx;font-weight:700;line-height:1.4;color:#f2f2f4;margin:24rpx 0}
.fb-commerce-subtitle{display:block;text-align:center;font-size:32rpx;font-weight:500;line-height:1.5;color:#dadadd;margin:16rpx 0}
.fb-commerce-description{display:block;text-align:center;font-size:28rpx;font-weight:400;line-height:1.7;color:#dadadd;margin:16rpx 0 24rpx;word-break:break-all}
.fb-commerce-card{padding:24rpx;margin:24rpx 0;border:1rpx solid #343438;border-radius:16rpx;background:#17171a}
.fb-commerce-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:16rpx 0}
.fb-commerce-row input{width:120rpx;text-align:right}
.fb-commerce-row button{flex:1;margin:0;font-size:28rpx;line-height:1.5;padding:16rpx 20rpx}
.fb-commerce-label{font-size:32rpx;color:#f2f2f4}
.fb-commerce-sku{display:flex;align-items:center;gap:16rpx;padding:16rpx 0}
.fb-commerce-card input,.fb-commerce-card textarea{box-sizing:border-box;min-height:80rpx;padding:16rpx 0;border-bottom:1rpx solid #343438;width:100%;font-size:28rpx;color:#f2f2f4}
.fb-commerce-card textarea{height:160rpx}
.fb-commerce-amount{font-size:36rpx;color:#f2f2f4;font-weight:700}
.fb-commerce-primary{margin:32rpx 0;font-size:32rpx;line-height:1.5;padding:24rpx}
.fb-commerce-error{display:block;margin:24rpx 0;padding:20rpx;border-radius:12rpx;color:#ffb3b3;background:#321e21;text-align:center}
.fb-commerce-tabs{display:flex;white-space:nowrap;margin:24rpx 0}
.fb-commerce-tabs button{display:inline-block;margin-right:12rpx;background:transparent;color:#85858b;font-size:28rpx;line-height:1.5;padding:12rpx 20rpx}
.fb-commerce-tabs button.is-active{color:#f2f2f4;border-bottom:2rpx solid #f2f2f4}
