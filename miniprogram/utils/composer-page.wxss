/* Page geometry only. Appearance is supplied by the single micro-page configuration. */
.fc-native-page{height:100vh;min-height:0;display:flex;flex-direction:column;overflow:hidden;position:relative;box-sizing:border-box;font-family:initial;font-weight:initial;line-height:normal}
.fc-native-status{flex:none}.fc-native-nav{position:relative;display:flex;align-items:center;flex:none;box-sizing:border-box}
.fc-native-logo image{display:block}.fc-native-scroll{flex:1;height:0;min-height:0}
.fc-native-main{display:flex;flex-direction:column;position:relative;box-sizing:border-box}
.fc-native-footer{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom,0px);z-index:100;font:inherit}
.fc-native-tab{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;justify-content:center;font:inherit}.fc-native-icon{width:1em;height:1em;background-size:contain;background-position:center;background-repeat:no-repeat}

.fc-native-list-retry{width:100%;text-align:center;font:inherit;color:inherit}
