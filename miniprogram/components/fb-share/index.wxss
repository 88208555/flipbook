.fb-share-modal{position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.6);display:flex;align-items:flex-end;color:#111}
.fb-share-dialog{width:100%;min-height:50vh;max-height:94vh;display:flex;flex-direction:column;overflow:hidden;background:#f5f5f5;border-radius:32rpx 32rpx 0 0;box-sizing:border-box}
.fb-share-heading{position:relative;flex:none;display:flex;align-items:center;min-height:92rpx;box-sizing:border-box;padding:20rpx 104rpx 20rpx 28rpx;font-size:30rpx;font-weight:600}
.fb-share-close{position:absolute;right:28rpx;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;background:none;color:#111;padding:0;margin:0;width:60rpx;height:60rpx;line-height:1;font-size:40rpx}.fb-share-close:after{border:0}
.fb-share-preview{flex:none;width:auto;height:auto;min-height:0;margin:0 28rpx}
.fb-share-product{padding:32rpx;box-sizing:border-box}
.fb-share-image-wrap{position:relative;width:100%;overflow:hidden;background:#f2f2f2;border-radius:24rpx}
.fb-share-product-image{display:block;width:100%;height:auto}
.fb-share-price{position:absolute;right:20rpx;bottom:20rpx;background:#111;color:#fff;border-radius:40rpx;padding:6rpx 20rpx;font-size:28rpx;line-height:1.5}
.fb-share-product-info{display:flex;align-items:stretch;gap:20rpx;margin-top:24rpx}
.fb-share-product-text{display:flex;flex-direction:column;flex:1;min-width:0}
.fb-share-product-name{display:block;font-size:30rpx;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fb-share-product-subtitle{display:block;font-size:24rpx;line-height:1.5;margin-top:8rpx;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fb-share-description{display:block;margin-top:auto;padding-top:16rpx;font-size:24rpx;line-height:36rpx;color:#666;white-space:pre-wrap;word-break:break-all}
.fb-share-code{display:flex;flex-direction:column;justify-content:flex-end;width:180rpx;flex:none;text-align:center;color:#666}
.fb-share-qr{display:block;width:180rpx;height:180rpx}.fb-share-hint{display:block;margin-top:10rpx;font-size:24rpx;line-height:36rpx}
.fb-share-buttons{flex:none;display:flex;gap:20rpx;box-sizing:border-box;padding:24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom))}
.fb-share-action{flex:1;border:0;border-radius:60rpx;font-size:28rpx;background:white;color:#111;margin:0}.fb-share-action.is-primary{background:#111;color:white}
.fb-share-status{padding:60rpx 0;text-align:center;font-size:26rpx}
.fb-share-canvas{position:fixed;left:-2000px;top:-2000px;pointer-events:none}
