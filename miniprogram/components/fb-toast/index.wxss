.fb-toast {
	position: fixed;
	right: 24rpx;
	bottom: calc(144rpx + env(safe-area-inset-bottom));
	z-index: 999;
	display: flex;
	align-items: center;
	gap: 12rpx;
	max-width: 460rpx;
	height: 72rpx;
	padding: 0 16rpx;
	background: rgba(22, 22, 24, 0.96);
	border: 1rpx solid #2A2A2E;
	border-radius: 36rpx;
}

.fb-toast-text {
	flex: 1;
	min-width: 0;
	color: #F2F2F4;
	font-size: 26rpx;
	line-height: 1.2;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.fb-toast-icon,
.fb-toast-close-icon {
	background-repeat: no-repeat;
	background-position: center;
	background-size: contain;
}

