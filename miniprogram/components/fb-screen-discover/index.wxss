.fb-page { padding-top:0; padding-bottom:0; min-height:0; }
.fb-read-page { height:auto; min-height:1000rpx; }
.fb-tab-page { padding-bottom:0; }

.fb-content { margin-top:0; }
.fb-member, .fb-fav-tabs, .fb-read-stage, .fb-hero, .fb-screen { margin-top:0; padding-top:0; }
.fb-screen { height:calc(100vh - 320rpx); min-height:720rpx; position:relative; }
.fb-hero { height:100%; }
.fb-hero-enter { position:absolute; top:0; left:0; right:0; bottom:96rpx; z-index:1; }

.fb-r-video-hit, .fb-hero-enter { bottom:0; }

.fb-screen { height:var(--fb-business-height, calc(100vh - 160px)); min-height:0; }
