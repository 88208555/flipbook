<view wx:if="{{node.visible}}" class="fc-node fc-{{node.kind}}" style="{{node.style}};{{node.kind === 'search' && searchFocused ? node.focusStyle : ''}}" data-link="{{node.link}}" bindtap="onLink">
 <text wx:if="{{node.kind === 'text'}}" class="fc-text">{{node.text}}</text>
 <view wx:elif="{{node.kind === 'icon'}}" class="fc-control-icon" style="{{node.iconStyle}}"/>
 <progress wx:elif="{{node.kind === 'progress'}}" percent="{{node.progress}}" activeColor="{{node.progressColor}}"/>
 <image wx:elif="{{node.kind === 'image' && node.src}}" class="fc-image" style="{{node.mediaStyle}}" src="{{node.src}}" mode="{{node.imageMode}}" data-preview="{{node.props.preview}}" bindtap="onPreview"/>
 <view wx:elif="{{node.kind === 'image' && node.type === 'member_avatar'}}" class="fc-control-icon" style="{{node.iconStyle}}"/>
 <video wx:elif="{{node.kind === 'video'}}" class="fc-image" style="{{node.mediaStyle}}" src="{{node.src}}" poster="{{node.poster}}" autoplay="{{node.props.autoplay}}" muted="{{node.props.muted}}" object-fit="{{node.props.fit || 'contain'}}"/>
 <block wx:elif="{{node.kind === 'container'}}"><fb-render wx:for="{{node.children}}" wx:key="id" node="{{item}}"/></block>
 <block wx:elif="{{node.kind === 'repeat'}}"><block wx:for="{{node.rows}}" wx:for-item="row" wx:key="id"><fb-render wx:for="{{row.children}}" wx:key="id" node="{{item}}"/></block></block>
 <view wx:elif="{{node.kind === 'gallery'}}" class="fc-gallery"><swiper vertical="{{node.vertical}}" current="{{current}}" autoplay="{{node.props.autoplay && node.props.interval > 0}}" interval="{{node.props.interval}}" bindchange="onSlide" style="height:{{node.props.boxHeight > 0 ? node.props.boxHeight * 2 + 'rpx' : galleryHeight + 'px'}}"><swiper-item wx:for="{{node.items}}" wx:key="index" wx:for-index="index"><video wx:if="{{item.video && !ended[index]}}" id="fc-{{node.id}}-{{index}}" class="fc-gallery-media" style="{{node.mediaStyle}}" src="{{item.video}}" poster="{{item.image || item.cover}}" autoplay="{{node.props.playVideo && current === index}}" muted="{{mutedOverride === null ? node.props.muted : mutedOverride}}" controls="{{node.props.controls}}" data-index="{{index}}" data-link="{{item.link}}" bindended="onMediaEnded" bindtap="onGalleryTap" object-fit="{{node.props.fit || 'contain'}}" bindloadedmetadata="onMediaLoad"/><image wx:else class="fc-gallery-media" style="{{node.mediaStyle}}" src="{{ended[index] && item.firstframe ? item.firstframe : item.image || item.cover}}" mode="{{node.imageMode}}" bindload="onMediaLoad" data-index="{{index}}" data-preview="{{node.props.preview}}" catchtap="onPreview"/></swiper-item></swiper></view>
 <scroll-view wx:elif="{{node.kind === 'sku'}}" scroll-x class="fc-skus"><view class="fc-sku-strip" style="{{node.stripStyle}}"><view wx:for="{{node.items}}" wx:key="index" wx:for-index="index" class="fc-sku" style="{{item.widthStyle}}" data-index="{{index}}" catchtap="onPick"><image class="fc-image fc-sku-image" style="{{node.props.itemHeight > 0 ? item.heightStyle : 'height:' + skuHeight + 'px'}};{{node.shapeStyle}}" src="{{item.image || item.cover}}" mode="{{node.thumbMode}}" bindload="onSkuLoad"/></view></view></scroll-view>
 <view wx:elif="{{node.kind === 'login'}}" class="fc-login-form">
  <view class="fc-login-tabs" style="{{node.login.tabStyle}}"><button class="fc-login-option" style="{{node.login.wechatStyle}}" disabled="{{node.login.busy || !node.login.wechat}}" data-action="login_wechat" catchtap="onLoginAction">{{node.props.wechatText}}</button><button class="fc-login-option" style="{{node.login.accountStyle}}" disabled="{{node.login.busy}}" data-action="login_account" catchtap="onLoginAction">{{node.props.accountText}}</button></view>
  <view wx:if="{{node.login.account}}" class="fc-login-fields">
   <input class="fc-login-input" style="{{node.login.controlStyle}}" placeholder="{{node.props.usernamePlaceholder}}" value="{{node.login.values.username}}" data-field="username" bindinput="onLoginField"/>
   <input class="fc-login-input" style="{{node.login.controlStyle}}" placeholder="{{node.props.passwordPlaceholder}}" value="{{node.login.values.password}}" password data-field="password" bindinput="onLoginField"/>
   <picker style="{{node.login.controlStyle}}" value="{{node.login.values.questionid || 0}}" range="{{['无安全提问','母亲的名字','爷爷的名字','父亲出生的城市','其中一位老师的名字','计算机型号','最喜欢的餐馆名称','驾驶执照最后四位']}}" bindchange="onLoginQuestion"><text>{{node.login.values.questionid > 0 ? questions[node.login.values.questionid] : node.props.questionPlaceholder}}</text></picker>
   <input class="fc-login-input" style="{{node.login.controlStyle}}" placeholder="{{node.props.answerPlaceholder}}" value="{{node.login.values.answer}}" data-field="answer" bindinput="onLoginField"/>
   <button class="fc-control" style="{{node.login.submitStyle}}" disabled="{{node.login.busy}}" data-action="login_submit" catchtap="onLoginAction">{{node.props.submitText}}</button>
   <button wx:if="{{node.login.binding}}" class="fc-control" style="{{node.login.controlStyle}}" disabled="{{node.login.busy}}" data-action="login_account_only" catchtap="onLoginAction">仅使用账号登录</button>
  </view><text wx:if="{{node.login.error}}" role="status">{{node.login.error}}</text>
 </view>
 <view wx:elif="{{node.kind === 'search'}}" class="fc-search"><input class="fc-input" placeholder="{{node.props.placeholder}}" value="{{node.context.keyword}}" bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" bindconfirm="onSearch" confirm-type="search"/></view>
 <input wx:elif="{{node.kind === 'input'}}" class="fc-login-input" placeholder="{{node.props.placeholder}}" password="{{node.props.field === 'password'}}" bindinput="onLoginField"/>
 <picker wx:elif="{{node.kind === 'question'}}" range="{{['无安全提问','母亲的名字','爷爷的名字','父亲出生的城市','其中一位老师的名字','计算机型号','最喜欢的餐馆名称','驾驶执照最后四位']}}" bindchange="onLoginQuestion"><text>{{node.props.placeholder}}</text></picker>
 <button wx:elif="{{node.kind === 'button' && node.props.action === 'customer'}}" class="fc-control" open-type="contact" session-from="{{node.context.commerce.customer.sessionFrom}}" show-message-card="{{node.context.commerce.customer.sendCard}}">{{node.text}}</button>
 <button wx:elif="{{node.kind === 'button'}}" class="fc-control {{node.active ? 'fc-active' : ''}}" style="{{node.buttonStyle}}" disabled="{{node.disabled}}" catchtap="onAction"><view wx:if="{{node.iconStyle}}" class="fc-control-icon" style="{{node.iconStyle}}"/>{{node.text}}</button>
 <view wx:elif="{{node.kind === 'filters' || node.kind === 'tabs'}}" class="fc-links"><text wx:for="{{node.items}}" wx:key="value" class="{{item.selected ? 'fc-active' : ''}}" style="{{item.style}}" data-link="{{item.href}}" catchtap="onLink">{{item.label}}</text></view>
 <view wx:elif="{{node.kind === 'select'}}" class="fc-choice">
  <button class="fc-choice-trigger" aria-label="{{node.choice.title}}" catchtap="onChoiceOpen"><view class="fc-control-icon" style="{{node.choice.iconStyle}}"/></button>
  <view wx:if="{{choiceOpen}}" class="fc-choice-mask" style="{{node.choice.maskStyle}}" catchtap="onChoiceClose"/>
  <view wx:if="{{choiceOpen}}" class="fc-choice-panel" style="{{node.choice.dialogStyle}}"><view class="fc-choice-head"><text style="{{node.choice.headingStyle}}">{{node.choice.title}}</text><button class="fc-control fc-choice-close" aria-label="关闭系列选择" catchtap="onChoiceClose">×</button></view><scroll-view scroll-y show-scrollbar="{{false}}" style="height:{{node.choice.listHeight}}"><view class="fc-choice-options" style="{{node.choice.listStyle}}"><view wx:for="{{node.items}}" wx:key="value" class="fc-choice-option" style="{{item.style}}" data-index="{{index}}" catchtap="onChoicePick"><text>{{item.label}}</text><text wx:if="{{item.selected}}">✓</text></view></view></scroll-view></view>
 </view>
 <view wx:elif="{{node.kind === 'actions'}}" class="fc-fab">
  <view wx:if="{{fabOpen}}" class="fc-fab-list" style="{{node.fab.listStyle}}"><button wx:if="{{node.props.showFavorite}}" class="fc-fab-item" style="{{node.fab.buttonStyle}}" data-action="favorite" catchtap="onAction" aria-label="收藏"><view class="fc-control-icon" style="{{fabFavorited ? node.fab.icons.bookmark_active : node.fab.icons.bookmark}}"/></button><button wx:if="{{node.props.showShare}}" class="fc-fab-item" style="{{node.fab.buttonStyle}}" open-type="share" aria-label="分享"><view class="fc-control-icon" style="{{node.fab.icons.share}}"/></button><button wx:if="{{node.props.showMute && node.fab.hasVideo}}" class="fc-fab-item" style="{{node.fab.buttonStyle}}" catchtap="onFabMute" aria-label="切换静音"><view class="fc-control-icon" style="{{fabMuted ? node.fab.icons.volume_off : node.fab.icons.volume_on}}"/></button></view>
  <button class="fc-fab-main" style="{{node.fab.buttonStyle}}" catchtap="onFabToggle" aria-label="{{fabOpen ? '收起操作' : '展开操作'}}"><view class="fc-control-icon" style="{{fabOpen ? node.fab.icons.close : node.fab.icons.plus}}"/></button>
 </view>
 <view wx:elif="{{node.kind === 'divider'}}" style="{{node.props.axis === 'vertical' ? 'height:' + (node.props.boxHeight > 0 ? '100%' : '1em') + ';border-left:' : 'border-top:'}}{{node.props.thickness > 0 ? node.props.thickness * 2 + 'rpx' : 'thin'}} {{node.props.borderStyle || 'solid'}} currentColor"/>
 <rich-text wx:elif="{{node.kind === 'markdown'}}" class="fc-content" nodes="{{node.html}}"/>
 <view wx:elif="{{node.kind === 'info'}}" class="fc-content"><text wx:if="{{node.props.text}}" style="{{node.headingStyle}}">{{node.props.text}}</text><view wx:for="{{node.infoRows}}" wx:key="index" class="fc-info-row"><text>{{item[0]}}</text><text>{{item[1]}}</text></view><block wx:if="{{node.props.showTable}}"><view wx:for="{{node.info.sizetable}}" wx:key="index" class="fc-table-row"><text wx:for="{{item}}" wx:key="index">{{item}}</text></view><text>{{node.info.sizeTableNote}}</text></block><rich-text wx:if="{{node.props.showContent}}" nodes="{{node.info.contentHtml}}"/></view>
 <view wx:elif="{{node.kind === 'tab'}}"><view class="fc-links"><text wx:for="{{node.tabs}}" wx:key="index" class="{{active === index ? 'fc-active' : ''}}" data-index="{{index}}" catchtap="onTab">{{item.title}}</text></view><block wx:for="{{node.tabs}}" wx:for-item="tab" wx:key="index"><block wx:if="{{active === index}}"><fb-render wx:for="{{tab.children}}" wx:key="id" node="{{item}}"/></block></block></view>
</view>
