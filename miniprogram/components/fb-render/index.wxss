/* Structure only; every appearance value arrives on node.style. */
.fc-node{box-sizing:border-box;min-width:0;position:relative;font:inherit;color:inherit}
.fc-text{white-space:pre-wrap;overflow-wrap:anywhere}
.fc-image{display:block;width:100%;height:auto;max-width:100%}
.fc-gallery{width:100%;overflow:hidden}.fc-gallery-media{display:block;width:100%;height:100%}
.fc-skus{width:100%}.fc-sku-strip{display:flex;min-width:100%;width:100%;align-items:flex-start}.fc-sku{flex:none;min-width:0;box-sizing:border-box}
.fc-search,.fc-links{display:flex;align-items:center;gap:inherit;justify-content:inherit}
.fc-input{flex:1;min-width:0;width:0;height:auto;min-height:1em;color:inherit;font:inherit;background:transparent;padding:0;border:0;margin:0}
.fc-node .fc-control{display:block;width:100%;height:auto;line-height:inherit;font:inherit;color:inherit;background:transparent;border:0;border-radius:0;padding:0;margin:0;text-align:inherit}
.fc-search .fc-control{width:auto;flex:none}.fc-control::after{border:0}
.fc-links{flex-wrap:wrap}
.fc-info-row{display:flex;justify-content:space-between}.fc-table-row{display:flex}.fc-table-row text{flex:1;min-width:0}
.fc-content{font:inherit;color:inherit;overflow-wrap:anywhere}

.fc-login-input{box-sizing:border-box;display:block;width:100%;height:auto;min-height:1em;font:inherit;color:inherit;border:0;border-radius:0;padding:0;margin:0;background:transparent}

.fc-control-icon{display:inline-block;width:1em;height:1em;vertical-align:middle;background-size:contain;background-position:center;background-repeat:no-repeat}

.fc-login-form,.fc-login-fields{display:flex;flex-direction:column;gap:inherit;width:100%}.fc-login{display:flex;flex-direction:column}.fc-login-tabs{display:flex;width:100%}.fc-login-tabs .fc-login-option{flex:1;min-width:0;width:0;box-sizing:border-box;margin:0;font:inherit;line-height:inherit;padding:0;border:0;background:transparent;color:inherit}.fc-login-option::after{border:0}.fc-login-option[disabled]{opacity:.45}

.fc-choice-trigger{display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:0;margin:0;border:0;border-radius:inherit;color:inherit;background:transparent;font:inherit}.fc-choice-trigger::after{border:0}
.fc-choice-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:200}
.fc-choice-panel{position:fixed;bottom:0;left:0;right:0;z-index:201;box-sizing:border-box}
.fc-choice-head,.fc-choice-option{display:flex;align-items:center;justify-content:space-between;gap:inherit}
.fc-choice-head .fc-choice-close{width:auto}.fc-choice-options{display:flex;flex-direction:column;gap:inherit}
.fc-fab{width:100%;height:100%}.fc-fab-list{position:absolute;bottom:calc(100% + var(--fc-fab-gap));left:0;display:flex;flex-direction:column;gap:inherit}
.fc-fab-main,.fc-fab-item{display:flex;align-items:center;justify-content:center;padding:0;margin:0;line-height:inherit;font:inherit;border:0}.fc-fab-main::after,.fc-fab-item::after{border:0}

.fc-choice-panel{display:flex;flex-direction:column;gap:inherit}
.fc-node .fc-control .fc-control-icon{flex:none}
