/* 首页：抖音式整屏竖向切换 */
.fb-logo {
	flex: 1;
	min-width: 0;
	color: var(--fb-white);
	font-size: 32rpx;
	font-weight: 700;
	letter-spacing: 6rpx;
}

.fb-hero {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	width: 100%;
	height: 100%;
}

.fb-hero-img {
	width: 100%;
	height: 100%;
	display: block;
}

.fb-hero-video {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	width: 100%;
	height: 100%;
}

.fb-hero-info {
	position: absolute;
	left: var(--fb-gap-4);
	right: 180rpx;
	bottom: calc(150rpx + env(safe-area-inset-bottom));
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.fb-hero-name {
	color: var(--fb-white);
	font-size: var(--fb-fs-xl);
	font-weight: 600;
	line-height: 1.25;
}

.fb-hero-sub {
	color: rgba(255, 255, 255, 0.82);
	font-size: 26rpx;
	line-height: 1.4;
}

.fb-screen > .fb-fab {
	bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 阅读页按钮组避开视频原生控制条 */
.fb-read-stage > .fb-fab {
	bottom: calc(var(--fb-gap-5) * 2);
}

/* 自定义 tabBar 下的列表页底部留白 */
.fb-tab-page {
	padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 分享按钮固定为圆形，覆盖小程序 button 默认宽度 */
button.fb-fab-item {
	width: 80rpx;
	height: 80rpx;
	min-width: 0;
	padding: 0;
	margin: 0;
	line-height: 1;
	border-radius: 50%;
	overflow: hidden;
}

button.fb-fab-item::after {
	border: none;
}

/* ===== 全站统一设计系统（唯一来源，页面禁止另写一套） ===== */

/* 导航栏：所有页面同一高度、同一水平内边距、标题同一行左对齐 */
.fb-topbar {
	display: flex;
	align-items: center;
	flex: none;
	height: calc(var(--fb-nav-h) + var(--fb-status-h, 0px));
	min-height: 0;
	padding-top: var(--fb-status-h, 0px);
	padding-right: calc(var(--fb-nav-pad-x) + var(--fb-capsule));
	padding-bottom: 0;
	padding-left: var(--fb-nav-pad-x);
	background: var(--fb-black);
}

.fb-back {
	flex: none;
	width: var(--fb-control);
	height: var(--fb-control);
	margin-left: calc(-1 * var(--fb-nav-pad-x));
	display: flex;
	align-items: center;
	justify-content: center;
}

.fb-icon-back {
	width: var(--fb-icon-size);
	height: var(--fb-icon-size);
}

.fb-topbar-title {
	flex: 1;
	min-width: 0;
	margin-left: 0;
	text-align: left;
	font-size: var(--fb-nav-fs);
	font-weight: 500;
	line-height: 1.2;
	color: var(--fb-text);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.fb-topbar-side {
	flex: none;
	min-width: var(--fb-control);
	display: flex;
	align-items: center;
	justify-content: flex-end;
}

.fb-topbar-action {
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
	line-height: 1.2;
}

/* 首页 Logo 与导航同一排、左对齐，与标题同一视觉基线 */
.fb-logo {
	display: flex;
	align-items: center;
	align-self: stretch;
	flex: 1;
	min-width: 0;
	margin-left: 0;
	padding-left: 0;
	color: var(--fb-white);
	font-size: 32rpx;
	font-weight: 700;
	line-height: 1.2;
}

/* 统一页签：收藏 / 记录 / 分类 / 偏好 / 详情共用同一套 */
.fb-tabs,
.fb-fav-tabs,
.fb-segment {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-5);
	min-height: var(--fb-tab-h);
	padding-right: var(--fb-gap-4);
	padding-left: var(--fb-gap-4);
	background: transparent;
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-tab,
.fb-fav-tab,
.fb-segment-item {
	position: relative;
	display: flex;
	align-items: center;
	flex: none;
	min-height: var(--fb-tab-h);
	padding: 0;
	margin: 0;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
	line-height: 1;
	text-align: left;
	background: transparent;
	border: 0;
	border-radius: 0;
}

.fb-tab.is-active,
.fb-fav-tab.is-active,
.fb-segment-item.is-active {
	color: var(--fb-text);
	font-weight: 500;
}

.fb-tab.is-active::after,
.fb-fav-tab.is-active::after,
.fb-segment-item.is-active::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: 10rpx;
	height: 4rpx;
	background: var(--fb-text);
	border-radius: 2rpx;
}

/* 导航栏下第一个内容块的统一间距 */
.fb-content {
	margin-top: var(--fb-content-gap);
}

/* 首块自带内边距的模块，去掉顶部内边距，保证所有页面首块间距完全一致 */
.fb-content.fb-pref-group {
	padding-top: 0;
}

/* 模块之间统一间距 */
.fb-section {
	margin-top: var(--fb-section-gap);
}

/* 所有列表行统一高度与分隔线 */
.fb-list-row {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-3);
	min-height: var(--fb-list-row-h);
	padding-top: 0;
	padding-bottom: 0;
	border-bottom: 1rpx solid var(--fb-line);
	color: var(--fb-text);
}

.fb-list-row:last-child {
	border-bottom: 0;
}

.fb-list-label {
	flex: 1;
	min-width: 0;
	font-size: var(--fb-fs-m);
	color: var(--fb-text);
}

/* 头像与标题字号统一 */










/* 分类页筛选：只保留一个向下箭头，复用收藏集返回图标旋转 90° */
.fb-cat-tabs {
	min-height: var(--fb-tab-h);
	padding: 0 var(--fb-gap-4);
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-cat-filter {
	flex: none;
	width: var(--fb-control);
	height: var(--fb-control);
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0;
	color: var(--fb-text-2);
}

.fb-icon-chevron-down {
	width: 24rpx;
	height: 24rpx;
	background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%201024%201024'%20fill='%23A6A6AC'%3E%3Cpath%20d='M364.8%20512L726.4%20150.4c12.8-12.8%2012.8-32%200-44.8s-32-12.8-44.8%200l-384%20384c-12.8%2012.8-12.8%2032%200%2044.8l384%20384c6.4%206.4%2016%209.6%2022.4%209.6s16-3.2%2022.4-9.6c12.8-12.8%2012.8-32%200-44.8L364.8%20512z'/%3E%3C/svg%3E");
	transform: rotate(-90deg);
}

/* 分类与筛选项和全站页签同一套字号与间距 */
.fb-chip-row {
	gap: var(--fb-gap-5);
	min-height: var(--fb-tab-h);
}

.fb-chip {
	position: relative;
	display: flex;
	align-items: center;
	min-height: var(--fb-tab-h);
	padding: 0;
	font-size: var(--fb-fs-s);
	line-height: 1;
	border-bottom: 0;
}

.fb-chip.is-active {
	border-bottom-color: transparent;
}

.fb-chip.is-active::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: 10rpx;
	height: 4rpx;
	background: var(--fb-text);
	border-radius: 2rpx;
}

/* 阅读页：视频、价格、规格、视频缩略图 */
.fb-reader-video {
	width: 100%;
	height: 100%;
	display: block;
	background: var(--fb-ink);
}

.fb-mute {
	position: absolute;
	right: var(--fb-gap-3);
	top: calc(var(--fb-status-h, 0px) + var(--fb-nav-h) + var(--fb-gap-2));
	z-index: 26;
	height: 48rpx;
	padding: 0 18rpx;
	display: flex;
	align-items: center;
	border: 1rpx solid rgba(255, 255, 255, 0.28);
	border-radius: 999rpx;
	background: rgba(0, 0, 0, 0.5);
	color: var(--fb-white);
	font-size: var(--fb-fs-xs);
}

.fb-caption {
	display: flex;
	flex-wrap: wrap;
	align-items: flex-start;
	justify-content: space-between;
	gap: var(--fb-gap-3);
	row-gap: 0;
	padding: var(--fb-gap-3) var(--fb-gap-4);
}

.fb-caption-main {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 6rpx;
}

.fb-price {
	flex: none;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: 2rpx;
}

.fb-price-sale {
	color: #E5484D;
	font-size: var(--fb-fs-l);
	font-weight: 600;
	line-height: 1.1;
}

.fb-price-origin {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
	text-decoration: line-through;
}

.fb-thumb-play {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(0, 0, 0, 0.32);
}

.fb-thumb-play .fb-icon {
	width: 40rpx;
	height: 40rpx;
}

.fb-icon-play {
	background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%201024%201024'%20fill='%23FFFFFF'%3E%3Cpath%20d='M512%2096C281.6%2096%2096%20281.6%2096%20512s185.6%20416%20416%20416%20416-185.6%20416-416S742.4%2096%20512%2096z%20m0%20768C316.8%20864%20160%20707.2%20160%20512S316.8%20160%20512%20160s352%20156.8%20352%20352-156.8%20352-352%20352zM662.4%20473.6l-153.6-105.6c-19.2-12.8-41.6-16-64-3.2-19.2%209.6-32%2032-32%2054.4V608c0%2022.4%2012.8%2044.8%2032%2054.4%209.6%203.2%2019.2%206.4%2028.8%206.4%2012.8%200%2025.6-3.2%2035.2-9.6l153.6-105.6c12.8-9.6%2019.2-22.4%2019.2-38.4s-6.4-32-19.2-41.6z'%20/%3E%3C/svg%3E");
}

.fb-spec-block {
	padding: 0 var(--fb-gap-4) var(--fb-gap-4);
	border-top: 1rpx solid var(--fb-line);
}

.fb-spec-row {
	display: flex;
	gap: var(--fb-gap-3);
	padding: 12rpx 0;
}

.fb-spec-label {
	flex: none;
	width: 88rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
	line-height: 56rpx;
}

.fb-spec-chips {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-wrap: wrap;
	gap: var(--fb-gap-2);
	align-items: center;
}

.fb-spec-chip {
	min-width: 96rpx;
	height: 56rpx;
	padding: 0 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
	border: 1rpx solid var(--fb-line);
	border-radius: var(--fb-radius-s);
}

.fb-spec-text {
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
	line-height: 1.4;
}

.fb-spec-table {
	margin-top: var(--fb-gap-2);
	border-top: 1rpx solid var(--fb-line);
}

.fb-spec-tr {
	display: flex;
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-spec-tr.is-head .fb-spec-td {
	color: var(--fb-text);
}

.fb-spec-td {
	flex: 1;
	min-width: 0;
	padding: 12rpx 4rpx;
	text-align: center;
	color: var(--fb-text-2);
	font-size: var(--fb-fs-xs);
	line-height: 1.3;
}




/* 顶部刷新状态：仅用于下拉/回顶刷新，无阴影、无投影 */
.fb-refresh {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(var(--fb-status-h, 0px) + var(--fb-nav-h));
        z-index: 40;
        height: 56rpx;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12rpx;
        background: var(--fb-ink-raised);
        color: var(--fb-text-2);
        font-size: var(--fb-fs-xs);
        opacity: 0;
        transform: translateY(-100%);
        transition: opacity 160ms ease, transform 160ms ease;
        pointer-events: none;
}

.fb-refresh.is-on {
        opacity: 1;
        transform: translateY(0);
}

.fb-refresh-spin {
        width: 22rpx;
        height: 22rpx;
        border: 2rpx solid var(--fb-line-strong);
        border-top-color: var(--fb-text);
        border-radius: 50%;
        animation: fb-refresh-spin 720ms linear infinite;
}

@keyframes fb-refresh-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
}

/* ============================================================
   微页面：导航栏、滚动区、底部导航
   内容组件样式由 components/fb-render 维护
   ============================================================ */
.fb-m-page {
	padding-bottom:var(--fb-current-tab-height,0px);
	display: flex;
	flex-direction: column;
	height: 100vh;
	overflow: hidden;
}

.fb-m-nav {
	flex: none;
}

.fb-m-nav-inner {
	position: relative;
	display: flex;
	align-items: center;
}

.fb-m-back {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	width: var(--fb-control);
	height: var(--fb-control);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.fb-m-logo {
	display: flex;
	align-items: center;
	max-width: 70%;
	overflow: hidden;
}

.fb-m-logo-img {
	max-height: 100%;
}

.fb-m-logo-text {
	line-height: 1.2;
	overflow: hidden;
	text-overflow: ellipsis;
}

.fb-m-scroll {
	flex: 1;
	min-height: 0;
	height: 0;
}

.fb-m-main {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.fb-m-tabbar {
	position:fixed;
	bottom:0;
	left:0;
	right:0;
	z-index:50;
	flex: none;
	display: flex;
	align-items: stretch;
	height: calc(var(--fb-nav-h) + env(safe-area-inset-bottom, 0px));
	padding-bottom: env(safe-area-inset-bottom, 0px);
	border-top: 1rpx solid var(--fb-line);
	background: var(--fb-black);
}

.fb-m-tab {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
	line-height: 1.2;
}

.fb-m-tab.is-on {
	color: var(--fb-text);
}

.fb-m-tab-icon {
	width: var(--fb-icon-size);
	height: var(--fb-icon-size);
	background-repeat: no-repeat;
	background-size: 100% 100%;
