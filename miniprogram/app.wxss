/* 操作菜单统一固定在当前媒体画面左下角 10px。 */
.fb-fab, .fb-screen > .fb-fab, .fb-read-stage > .fb-fab { left:10px; right:auto; bottom:10px; }
.fb-hero-info { bottom:24px; left:80px; right:20px; }
.fb-top-refresh { position:fixed; left:50%; transform:translateX(-50%); z-index:100; width:24px; height:24px; display:flex; align-items:center; justify-content:center; pointer-events:none; }
.fb-top-refresh .fb-refresh-spin { width:18px; height:18px; }

.fb-icon-volume-on { background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2024%2024%27%20fill%3D%27none%27%20stroke%3D%27white%27%20stroke-width%3D%271.7%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%3E%3Cpath%20d%3D%27M11%205%206%209H3v6h3l5%204z%27%2F%3E%3Cpath%20d%3D%27M15%208a6%206%200%200%201%200%208m3-11a10%2010%200%200%201%200%2014%27%2F%3E%3C%2Fsvg%3E"); }

.fb-icon-volume-off { background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2024%2024%27%20fill%3D%27none%27%20stroke%3D%27white%27%20stroke-width%3D%271.7%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%3E%3Cpath%20d%3D%27M11%205%206%209H3v6h3l5%204zM16%209l5%206m0-6-5%206%27%2F%3E%3C%2Fsvg%3E"); }

/* 紧凑系列列表，替代有大块空白的系统滚轮。 */
.fb-series-mask { position:fixed; inset:0; z-index:200; background:rgba(0,0,0,.6); display:flex; align-items:flex-end; }
.fb-series-sheet { width:100%; background:#141416; color:#F2F2F4; border-radius:16px 16px 0 0; padding-bottom:env(safe-area-inset-bottom); overflow:hidden; }
.fb-series-head { display:flex; align-items:center; justify-content:space-between; height:52px; padding:0 20px; border-bottom:1px solid #2A2A2E; font-size:15px; }
.fb-series-cancel { color:#A6A6AC; font-size:14px; }
.fb-series-options { max-height:50vh; height:auto; }
.fb-series-option { display:flex; justify-content:space-between; align-items:center; min-height:48px; padding:0 20px; font-size:14px; color:#A6A6AC; }
.fb-series-option.is-active { color:#fff; }

.fb-m-floating-logo { position:absolute; z-index:25; display:flex; align-items:center; }

.fb-fab-list { gap:var(--fb-action-gap, 10px); }
.fb-fab-item, button.fb-fab-item, .fb-fab-main { width:var(--fb-action-size,40px); height:var(--fb-action-size,40px); border-radius:var(--fb-action-radius,20px); background:var(--fb-action-bg,rgba(11,11,12,.7)); color:var(--fb-action-color,#fff); }
.fb-fab-item .fb-icon { width:20px; height:20px; background-size:contain; background-position:center; background-repeat:no-repeat; }

.fb-m-page { position:relative; }
.fb-m-nav.is-overlay { position:absolute; top:0; left:0; right:0; z-index:30; }

.fb-view-title-main { display:block; font-weight:700; line-height:1.3; }
.fb-view-title-sub { display:block; font-size:13px; margin-top:4px; color:rgba(255,255,255,.8); }

/* Member center and quick login use the same mobile sizing on both clients. */


.fb-avatar image {width:100%;height:100%;border-radius:50%;}
.fb-avatar .fb-icon {width:44rpx;height:44rpx;}




.fb-markdown {display:block;line-height:1.8;overflow-wrap:anywhere;}



.fb-m-overlays{position:absolute;inset:0;z-index:10;pointer-events:none}.fb-m-tabbar{box-sizing:border-box}.fb-m-tab-icon{background-size:contain;background-position:center;background-repeat:no-repeat}

/* Product data regions share full-width, square defaults. */
.fb-product-info { display:block;width:100%;box-sizing:border-box;line-height:1.6; }
.fb-info-heading { display:block;margin:0 0 20rpx;font-size:inherit;font-weight:600;line-height:inherit; }
.fb-info-row { display:flex;align-items:center;gap:24rpx;padding:16rpx 0; }
.fb-info-label { min-width:6em;flex:none;white-space:nowrap;color:var(--fb-text-3); }
.fb-info-value { min-width:0;flex-shrink:1;overflow-wrap:anywhere;word-break:break-word; }
.fb-info-values { display:flex;gap:12rpx;flex-wrap:wrap;min-width:0; }
.fb-info-chip { display:inline-block;box-sizing:border-box;padding:4rpx 16rpx;border:1rpx solid var(--fb-line); }
.fb-info-table { font-size:24rpx; }
.fb-info-tr { display:flex;border-bottom:1rpx solid var(--fb-line); }
.fb-info-cell { flex:1;min-width:0;box-sizing:border-box;padding:10rpx 4rpx;text-align:center;font-size:inherit; }
.fb-info-tr:first-child { font-weight:600; }
.fb-info-note { display:block;margin:0;font-size:24rpx;color:var(--fb-text-3);line-height:1.6; }








.fb-product-media { display:block;width:100%;box-sizing:border-box;font-size:28rpx;line-height:1.6; }
.fb-product-media-head { display:flex;align-items:baseline;justify-content:space-between;gap:20rpx; }
.fb-product-media-code { font-size:24rpx;color:var(--fb-text-3); }
.fb-product-media-list { display:flex;flex-direction:column; }
.fb-product-media-item { display:block;width:100%; }
.fb-product-media-image { display:block;width:100%;height:auto; }
.fb-product-media-text { display:block;font-size:24rpx;color:var(--fb-text-3);line-height:1.6; }
.fb-code-tag{display:inline-block;font-size:22rpx;line-height:1.4;padding:2rpx 8rpx;margin-right:12rpx;border:1rpx solid currentColor;vertical-align:middle}.fb-product-floating{position:absolute;z-index:24}.fb-hero-info{display:flex;flex-direction:column;gap:8rpx}.fb-hero-name{line-height:1.3}.fb-hero-sub{display:block}.fb-detail-shots{padding-left:0;padding-right:0}.fb-detail-shot{border-radius:0}.fb-spec{border-top:0;margin-left:0;margin-right:0;border-radius:0}

/* Back controls retain the same configured appearance with or without the navigation bar. */
.fb-m-back-anchor{position:absolute;top:50%;transform:translateY(-50%);z-index:31}
.fb-m-back-floating{position:absolute;transform:translateY(-50%);z-index:31}
.fb-m-back-control{box-sizing:border-box}

