/**
 * 工装电子画册 · 小程序基础样式
 * 只使用黑白灰令牌，禁止页面内硬编码颜色。
 */
page {
	--fb-black: #0B0B0C;
	--fb-ink: #141416;
	--fb-ink-raised: #1C1C1F;
	--fb-line: #2A2A2E;
	--fb-line-strong: #3A3A40;
	--fb-text: #F2F2F4;
	--fb-text-2: #A6A6AC;
	--fb-text-3: #6E6E74;
	--fb-white: #FFFFFF;
	--fb-scrim: rgba(0, 0, 0, 0.72);
	--fb-radius-s: 8rpx;
	--fb-radius-m: 16rpx;
	--fb-radius-l: 28rpx;
	--fb-radius-pill: 999rpx;
	--fb-gap-1: 8rpx;
	--fb-gap-2: 16rpx;
	--fb-gap-3: 24rpx;
	--fb-gap-4: 32rpx;
	--fb-gap-5: 48rpx;
	--fb-fs-xs: 22rpx;
	--fb-fs-s: 26rpx;
	--fb-fs-m: 30rpx;
	--fb-fs-l: 36rpx;
	--fb-fs-xl: 44rpx;
	--fb-fs-title: 34rpx;

	/* 统一结构令牌：全站导航、间距、列表、头像只允许引用这里 */
	--fb-nav-h: 88rpx;
	--fb-nav-pad-x: 32rpx;
	--fb-nav-fs: 30rpx;
	--fb-capsule: 176rpx;
	--fb-control: 64rpx;
	--fb-icon-size: 32rpx;
	--fb-content-gap: 48rpx;
	--fb-section-gap: 48rpx;
	--fb-list-row-h: 104rpx;
	--fb-avatar: 72rpx;
	--fb-thumb: 96rpx;
	--fb-tab-h: 72rpx;

	background: var(--fb-black);
	color: var(--fb-text);
	font-size: var(--fb-fs-m);
	line-height: 1.5;
	font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
image,
button,
input,
scroll-view,
swiper,
swiper-item {
	box-sizing: border-box;
}

image {
	display: block;
}

.fb-page {
	min-height: 100vh;
	padding-bottom: env(safe-area-inset-bottom);
}

.fb-topbar {
	display: flex;
	align-items: center;
	padding: var(--fb-gap-2) var(--fb-gap-4);
	min-height: 88rpx;
	background: var(--fb-black);
}

.fb-topbar-title {
	flex: 1;
	min-width: 0;
	text-align: left;
	font-size: var(--fb-fs-m);
	font-weight: 500;
	color: var(--fb-text);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.fb-topbar-side {
	flex: none;
	min-width: 96rpx;
	display: flex;
	justify-content: flex-end;
}

.fb-topbar-side-left {
	justify-content: flex-start;
}

.fb-back {
	flex: none;
	width: 72rpx;
	height: 72rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--fb-text);
	font-size: var(--fb-fs-xl);
}

.fb-topbar-action {
	padding: var(--fb-gap-1) 0;
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
}

.fb-body {
	padding: 0 var(--fb-gap-4);
}

.fb-tabs {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-4);
	padding: var(--fb-gap-2) var(--fb-gap-4);
}

.fb-tab {
	position: relative;
	padding: var(--fb-gap-1) 0;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-l);
}

.fb-tab.is-active {
	color: var(--fb-text);
	font-weight: 600;
}

.fb-tab.is-active::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: -6rpx;
	height: 4rpx;
	background: var(--fb-text);
	border-radius: var(--fb-radius-pill);
}

.fb-search {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-2);
	height: 76rpx;
	padding: 0 var(--fb-gap-3);
	margin: 0 var(--fb-gap-4);
	background: var(--fb-ink-raised);
	border-radius: var(--fb-radius-m);
	color: var(--fb-text-3);
}

.fb-search-input {
	flex: 1;
	min-width: 0;
	color: var(--fb-text);
	font-size: var(--fb-fs-s);
}

.fb-chips {
	display: flex;
	align-items: center;
	width: 100%;
	gap: var(--fb-gap-5);
	white-space: nowrap;
}

.fb-chip-row {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-4);
	padding: var(--fb-gap-2) var(--fb-gap-4);
}

.fb-chip {
	flex: none;
	padding: var(--fb-gap-1) 0;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
	border-bottom: 3rpx solid transparent;
}

.fb-chip.is-active {
	color: var(--fb-text);
	border-bottom-color: var(--fb-text);
}

.fb-grid {
	display: flex;
	flex-wrap: wrap;
	gap: var(--fb-gap-4) var(--fb-gap-3);
	padding: var(--fb-gap-3) var(--fb-gap-4);
}

.fb-card {
	width: calc(50% - 12rpx);
}

.fb-card-cover {
	position: relative;
	width: 100%;
	height: 420rpx;
	overflow: hidden;
	border-radius: var(--fb-radius-m);
	background: var(--fb-ink-raised);
}

.fb-card-cover image {
	width: 100%;
	height: 100%;
}

.fb-card-title {
	display: block;
	margin-top: var(--fb-gap-2);
	font-size: var(--fb-fs-m);
	color: var(--fb-text);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.fb-card-meta {
	display: block;
	margin-top: 4rpx;
	font-size: var(--fb-fs-xs);
	color: var(--fb-text-3);
}

.fb-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--fb-gap-2);
	padding: 160rpx var(--fb-gap-5);
	text-align: center;
}

.fb-empty-title {
	font-size: var(--fb-fs-l);
	color: var(--fb-text);
}

.fb-empty-text {
	font-size: var(--fb-fs-s);
	color: var(--fb-text-3);
}

.fb-screen .fb-empty {
	flex: 1;
}

.fb-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 240rpx;
	height: 80rpx;
	margin-top: var(--fb-gap-3);
	padding: 0 var(--fb-gap-5);
	color: var(--fb-black);
	font-size: var(--fb-fs-s);
	background: var(--fb-white);
	border-radius: var(--fb-radius-pill);
}

.fb-btn-ghost {
	color: var(--fb-text);
	background: transparent;
	border: 1rpx solid var(--fb-line-strong);
}

.fb-segment {
	display: flex;
	padding: 0 var(--fb-gap-4);
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-segment-item {
	flex: 1;
	padding: var(--fb-gap-3) 0;
	text-align: center;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-m);
	border-bottom: 3rpx solid transparent;
}

.fb-segment-item.is-active {
	color: var(--fb-text);
	border-bottom-color: var(--fb-text);
}









.fb-menu-note {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}









.fb-hero {
	position: relative;
	width: 100%;
	height: 960rpx;
	background: var(--fb-ink);
}

.fb-hero-wrap {
	position: relative;
}

.fb-hero image {
	width: 100%;
	height: 100%;
}

.fb-dots {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: var(--fb-gap-1);
	padding: var(--fb-gap-3) 0;
}

.fb-dot {
	width: 10rpx;
	height: 10rpx;
	background: var(--fb-line-strong);
	border-radius: var(--fb-radius-pill);
}

.fb-dot.is-active {
	width: 32rpx;
	background: var(--fb-text);
}

.fb-info {
	padding: var(--fb-gap-3) var(--fb-gap-4);
}

.fb-info-title {
	display: block;
	font-size: var(--fb-fs-xl);
	font-weight: 600;
}

.fb-info-sub {
	display: block;
	margin-top: var(--fb-gap-1);
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}

.fb-switch-row {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-3);
	padding: var(--fb-gap-4) 0;
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-switch-title {
	flex: 1;
}

.fb-footbar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: var(--fb-gap-3) var(--fb-gap-4) calc(var(--fb-gap-3) + env(safe-area-inset-bottom));
	background: var(--fb-black);
	border-top: 1rpx solid var(--fb-line);
}

.fb-foot-hint {
	display: block;
	text-align: center;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

/* 顶栏页签 / 分区标题 */
.fb-tabs-top {
	flex: 1;
	min-width: 0;
	padding: 0;
	gap: var(--fb-gap-4);
}

.fb-section-head {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	padding: var(--fb-gap-4) var(--fb-gap-4) 0;
}

.fb-section-title {
	font-size: var(--fb-fs-l);
	font-weight: 600;
}

.fb-section-count {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

/* 搜索与筛选 */
.fb-search-icon {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

.fb-search-placeholder {
	color: var(--fb-text-3);
}

.fb-filterbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--fb-gap-2) var(--fb-gap-4);
}

.fb-filter {
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
}

.fb-filter-caret {
	margin-left: 4rpx;
	color: var(--fb-text-3);
}

.fb-filter-count {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

/* 我的 */










.fb-member-link {
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
}

/* 阅读页 */
.fb-read {
	display: flex;
	flex-direction: column;
	height: 100vh;
	padding-bottom: 0;
}

.fb-read .fb-topbar {
	flex: none;
}

.fb-read .fb-footbar {
	position: static;
	flex: none;
}

.fb-reader-wrap {
	position: relative;
	flex: 1;
	min-height: 0;
	background: var(--fb-ink);
}

.fb-rail {
	position: absolute;
	right: var(--fb-gap-3);
	bottom: var(--fb-gap-5);
	display: flex;
	flex-direction: column;
	gap: var(--fb-gap-3);
}

.fb-rail-btn {
	width: 84rpx;
	padding: var(--fb-gap-2) 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4rpx;
	color: var(--fb-text);
	font-size: var(--fb-fs-xs);
	line-height: 1.2;
	background: rgba(0, 0, 0, 0.55);
	border: 1rpx solid var(--fb-line);
	border-radius: var(--fb-radius-m);
	text-align: center;
}

.fb-rail-btn::after {
	border: none;
}

.fb-rail-icon {
	font-size: var(--fb-fs-m);
}

.fb-rail-text {
	color: var(--fb-text-2);
}

.fb-read-meta {
	padding: var(--fb-gap-3) var(--fb-gap-4) var(--fb-gap-2);
}

.fb-read-title {
	display: block;
	font-size: var(--fb-fs-l);
	font-weight: 600;
}

.fb-read-sub {
	display: block;
	margin-top: 4rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}

.fb-thumbs {
	flex: none;
	width: 100%;
	white-space: nowrap;
}

.fb-thumb-row {
	display: flex;
	gap: var(--fb-gap-2);
	padding: var(--fb-gap-1) var(--fb-gap-4) var(--fb-gap-3);
}

.fb-thumb-item {
	position: relative;
	flex: none;
	width: 120rpx;
	height: 132rpx;
	border: 2rpx solid transparent;
	border-radius: var(--fb-radius-s);
	overflow: hidden;
}

.fb-thumb-item.is-current {
	border-color: var(--fb-text);
}

.fb-thumb-img {
	width: 100%;
	height: 100%;
}

.fb-thumb-blank {
	background: var(--fb-ink-raised);
}

.fb-thumb-index {
	position: absolute;
	left: 8rpx;
	bottom: 4rpx;
	color: var(--fb-text);
	font-size: var(--fb-fs-xs);
}

/* 本册目录 */
.fb-catalog {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 30;
	display: flex;
	flex-direction: column;
	background: var(--fb-black);
}

.fb-catalog-head {
	display: flex;
	align-items: center;
	padding: var(--fb-gap-2) var(--fb-gap-4) var(--fb-gap-3);
}

.fb-catalog-headmain {
	flex: 1;
	min-width: 0;
	text-align: center;
}

.fb-catalog-headtitle {
	display: block;
	font-size: var(--fb-fs-m);
	font-weight: 600;
}

.fb-catalog-headsub {
	display: block;
	margin-top: 4rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

.fb-catalog-close {
	flex: none;
	width: 72rpx;
	text-align: center;
	color: var(--fb-text-2);
	font-size: var(--fb-fs-xl);
}

.fb-catalog-tabs {
	display: flex;
	border-top: 1rpx solid var(--fb-line);
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-catalog-tab {
	flex: 1;
	padding: var(--fb-gap-3) 0;
	text-align: center;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
	border-bottom: 3rpx solid transparent;
}

.fb-catalog-tab.is-active {
	color: var(--fb-text);
	border-bottom-color: var(--fb-text);
}

.fb-catalog-body {
	flex: 1;
	min-height: 0;
}

.fb-catalog-grid {
	display: flex;
	flex-wrap: wrap;
	gap: var(--fb-gap-2);
	padding: var(--fb-gap-3) var(--fb-gap-4);
}

.fb-catalog-cell {
	position: relative;
	width: calc((100% - 32rpx) / 3);
	border: 2rpx solid transparent;
	border-radius: var(--fb-radius-s);
}

.fb-catalog-cell.is-current {
	border-color: var(--fb-text);
}

.fb-catalog-media {
	height: 260rpx;
	border-radius: var(--fb-radius-s);
	overflow: hidden;
}

.fb-catalog-media image {
	width: 100%;
	height: 100%;
}

.fb-catalog-caption {
	display: flex;
	gap: var(--fb-gap-1);
	padding: var(--fb-gap-2) 4rpx var(--fb-gap-1);
}

.fb-catalog-cellindex {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

.fb-catalog-celltitle {
	flex: 1;
	min-width: 0;
	color: var(--fb-text-2);
	font-size: var(--fb-fs-xs);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.fb-catalog-current {
	display: block;
	padding: 0 4rpx var(--fb-gap-1);
	color: var(--fb-text);
	font-size: var(--fb-fs-xs);
}

.fb-catalog-empty {
	padding-top: 160rpx;
}

.fb-catalog-foot {
	flex: none;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--fb-gap-3) var(--fb-gap-4) calc(var(--fb-gap-3) + env(safe-area-inset-bottom));
	border-top: 1rpx solid var(--fb-line);
}

.fb-catalog-continue {
	padding: var(--fb-gap-2) var(--fb-gap-4);
	background: var(--fb-ink-raised);
	border-radius: var(--fb-radius-pill);
	font-size: var(--fb-fs-s);
}

.fb-topbar-float {
	background: linear-gradient(180deg, var(--fb-scrim), transparent);
}

.fb-reader {
	height: 100%;
	background: var(--fb-ink);
}

.fb-reader-image {
	width: 100%;
	height: 100%;
}

.fb-reader-fallback {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--fb-gap-2);
	height: 100%;
	padding: 0 var(--fb-gap-5);
	text-align: center;
}

.fb-reader-products {
	display: flex;
	flex-wrap: wrap;
	gap: var(--fb-gap-2);
	justify-content: center;
}

.fb-reader-product {
	padding: var(--fb-gap-1) var(--fb-gap-3);
	color: var(--fb-text-2);
	font-size: var(--fb-fs-xs);
	border: 1rpx solid var(--fb-line-strong);
	border-radius: var(--fb-radius-pill);
}

.fb-reader-counter-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-bottom: var(--fb-gap-2);
}

.fb-counter {
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
	letter-spacing: 1rpx;
}

/* 目录抽屉 */
.fb-sheet {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 20;
}

.fb-sheet-backdrop {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: var(--fb-scrim);
}

.fb-sheet-panel {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	max-height: 72vh;
	display: flex;
	flex-direction: column;
	background: var(--fb-ink);
	border-radius: var(--fb-radius-l) var(--fb-radius-l) 0 0;
	padding-bottom: env(safe-area-inset-bottom);
}

.fb-sheet-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--fb-gap-3) var(--fb-gap-4);
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-sheet-title {
	font-size: var(--fb-fs-m);
}

.fb-sheet-close {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}

.fb-sheet-body {
	flex: 1;
	min-height: 0;
}

.fb-catalog-row {
	display: flex;
	align-items: center;
	gap: var(--fb-gap-3);
	padding: var(--fb-gap-3) var(--fb-gap-4);
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-catalog-row.is-active {
	background: var(--fb-ink-raised);
}

.fb-catalog-index {
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

.fb-catalog-title {
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* 款式详情 */
.fb-product-head {
	padding: var(--fb-gap-2) var(--fb-gap-4) var(--fb-gap-4);
}

.fb-product-name {
	display: block;
	font-size: var(--fb-fs-xl);
	font-weight: 600;
}

.fb-product-meta {
	display: block;
	margin-top: var(--fb-gap-1);
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}

.fb-product-summary {
	display: block;
	margin-top: var(--fb-gap-2);
	color: var(--fb-text-2);
	font-size: var(--fb-fs-s);
}

.fb-detail-list {
	padding: var(--fb-gap-3) var(--fb-gap-4) 200rpx;
}

.fb-detail-item {
	margin-bottom: var(--fb-gap-4);
}

.fb-detail-media {
	width: 100%;
	height: 520rpx;
	overflow: hidden;
	border-radius: var(--fb-radius-m);
	background: var(--fb-ink-raised);
}

.fb-detail-media image {
	width: 100%;
	height: 100%;
}

.fb-detail-grid {
	display: flex;
	flex-wrap: wrap;
	gap: var(--fb-gap-3);
	padding: var(--fb-gap-3) var(--fb-gap-4) 200rpx;
}

.fb-detail-cell {
	width: calc(50% - 12rpx);
}

.fb-detail-cell .fb-detail-media {
	height: 320rpx;
}

.fb-detail-title {
	display: block;
	margin-top: var(--fb-gap-2);
	font-size: var(--fb-fs-m);
}

.fb-detail-text {
	display: block;
	margin-top: 4rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-xs);
}

.fb-spec {
	padding: var(--fb-gap-3) var(--fb-gap-4) 200rpx;
}

.fb-spec-row {
	display: flex;
	align-items: flex-start;
	gap: var(--fb-gap-3);
	padding: var(--fb-gap-3) 0;
	border-bottom: 1rpx solid var(--fb-line);
}

.fb-spec-label {
	flex: none;
	width: 100rpx;
	color: var(--fb-text-3);
	font-size: var(--fb-fs-s);
}

